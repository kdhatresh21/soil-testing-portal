
# Flask application secret
SECRET_KEY=replace-with-a-long-random-secret

# Database connection (use a separate online database for deployment)
DB_USER=your_online_database_user
DB_PASSWORD=your_online_database_password
DB_HOST=your_online_database_host
DB_NAME=your_online_database_name

# Gmail SMTP settings (optional)
SMTP_EMAIL=your_gmail_address
SMTP_APP_PASSWORD=your_gmail_app_password
